<group name="lab04,sysmon,">
	<rule id="100201" level="3">
		<if_sid>61603</if_sid>
		<field name="win.eventdata.image" type="pcre2">(?i)\\notepad\.exe$</field>
		<description>LAB-04: Notepad process created - $(win.eventdata.image)</description>
		<group>lab04_process_test,</group>
	</rule>
</group>
